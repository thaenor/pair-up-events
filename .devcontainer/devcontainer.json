{
  "name": "pair-up-events",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    }
  },
  "containerEnv": {
    "VITE_USE_EMULATOR": "true"
  },
  "mounts": [
    "source=pair-up-events-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=pair-up-events-npm,target=/home/node/.npm,type=volume",
    "source=pair-up-events-firebase,target=/home/node/.cache/firebase,type=volume",
    "source=pair-up-events-playwright,target=/home/node/.cache/ms-playwright,type=volume"
  ],
  "forwardPorts": [5173, 8080, 4000, 4400, 8081, 9099, 9150, 9199],
  "portsAttributes": {
    "5173": { "label": "Vite dev server", "onAutoForward": "openBrowser" },
    "8080": { "label": "Vite preview" },
    "4000": { "label": "Firebase Emulator UI" },
    "4400": { "label": "Firebase Emulator Hub" },
    "8081": { "label": "Firestore emulator" },
    "9099": { "label": "Auth emulator" },
    "9150": { "label": "Firestore WebChannel" },
    "9199": { "label": "Storage emulator" }
  },
  "initializeCommand": "docker volume create pair-up-events-node_modules && docker run --rm -v pair-up-events-node_modules:/vol alpine chown -R 1000:1000 /vol",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}

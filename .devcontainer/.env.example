# Copy this file to .env.local inside the container and fill in your values.
# The .env.local file is git-ignored and should NEVER be committed.

# ── Firebase (local emulator defaults — no real credentials needed for local dev) ──
VITE_USE_EMULATOR=true

# ── Firebase project config (only needed for `dev:live` against real Firebase) ──
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# .env.example
#
# Copy this file to .env.local and fill in the values for your Firebase project.
# See FIREBASE_SETUP.md for step-by-step instructions on where to find each value.
#
#   cp .env.example .env.local
#
# Never commit .env.local — it is already listed in .gitignore.

# Firebase project configuration
# Found in Firebase Console → Project Settings → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=AIzaSy-your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:your-app-id-here
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Sentry error tracking
# Found in Sentry → Settings → Projects → <project> → Client Keys (DSN)
VITE_SENTRY_DSN=https://your-public-key@o0000000.ingest.sentry.io/0000000

# Firebase App Check — reCAPTCHA v3 site key
# Found in Google reCAPTCHA Admin Console → your site → Settings
VITE_RECAPTCHA_SITE_KEY=6LeYour-recaptcha-v3-site-key-here

# App version string (used for display/logging purposes)
VITE_APP_VERSION=1.0.0

# Emulator toggle
# Set to "false" to bypass local emulators and connect directly to live Firebase.
# When running on localhost this defaults to emulator mode automatically.
VITE_USE_EMULATOR=true

# Keep Docker build context lean.
# Target: < 50MB excluding node_modules (which is never copied in — bind mount only).

# Dependencies (installed fresh inside the image)
node_modules/

# Build outputs
dist/
build/
coverage/

# Test artifacts
test-results/
playwright-report/
playwright/.cache/

# Git metadata
.git/
.gitignore
.gitattributes

# Agent ephemera (regenerated per task)
.agents/scratch/
Docs/agent-reports/

# Editor / OS junk
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files (never baked in — loaded at runtime)
.env
.env.*
!.env.example

# Misc
README.md
Docs/_archived/
